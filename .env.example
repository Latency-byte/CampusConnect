# CampusConnect — environment variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# Google Gemini API key
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Premium access token (used by /api/login and /api/chat)
# Change this to something secret before any real deployment
PREMIUM_TOKEN=premium-demo-token

# Express server port (optional — defaults to 3001)
# PORT=3001
